					"type": 3,
					"enable": 1,
					"mouse": "Raises dimmer for the current interior or exterior profile.",
					"vars": [{ "configINI": "Hotkeys:DimmerIncrease", "default": 78 }]
				},
				"2": {
					"title": "Decrease Dimmer",
					"type": 3,
					"enable": 1,
					"mouse": "Lowers dimmer for the current interior or exterior profile.",
					"vars": [{ "configINI": "Hotkeys:DimmerDecrease", "default": 74 }]
				},
				"3": {
					"title": "Increase Intensity",
					"type": 3,
					"enable": 1,
					"mouse": "Raises intensity for the current interior or exterior profile.",
					"vars": [{ "configINI": "Hotkeys:IntensityIncrease", "default": 55 }]
				},
				"4": {
					"title": "Decrease Intensity",
					"type": 3,
					"enable": 1,
					"mouse": "Lowers intensity for the current interior or exterior profile.",
					"vars": [{ "configINI": "Hotkeys:IntensityDecrease", "default": 181 }]
